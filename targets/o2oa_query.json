{
  "base": "http://127.0.0.1:20020",
  "health_url": "http://127.0.0.1:80/",

  "auth": {
    "type": "raw_token",
    "header": "Authorization",
    "token_env": "NV_TOKEN",
    "also_cookie": "x-token"
  },

  "body_only_mode": 1,
  "default_endpoint": "cms_doc_list",

  "endpoints": [
    {
      "name": "person_detail",
      "method": "POST",
      "path": "/x_organization_assemble_express/jaxrs/person/detail/xadmin@o2oa@P"
    },
    {
      "name": "review_count",
      "method": "POST",
      "path": "/x_processplatform_assemble_surface/jaxrs/review/v2/count"
    },
    {
      "name": "cms_attachment_download_query",
      "method": "GET",
      "path": "/x_cms_assemble_control/jaxrs/fileinfo/download/document/{attachmentId}",
      "transport": "url_query",
      "request_body": "none",
      "runtime_path_parameter": {
        "placeholder": "{attachmentId}",
        "env": "NV_O2OA_ATTACHMENT_ID"
      }
    },
    {
      "name": "file_share_list_my_query",
      "method": "GET",
      "path": "/x_file_assemble_control/jaxrs/share/list/my",
      "transport": "url_query",
      "request_body": "none"
    },
    {
      "name": "cms_document_create_save",
      "method": "POST",
      "path": "/x_cms_assemble_control/jaxrs/document",
      "mutation_profile": "o2oa_document_create",
      "capture_document_id": true,
      "runtime_body_parameter": {
        "field": "categoryId",
        "env": "NV_O2OA_CATEGORY_ID",
        "marker": "__NV_RUNTIME_CATEGORY_ID__"
      },
      "runtime_body_path_parameters": [
        {
          "path": ["readerList", 0, "permissionObjectCode"],
          "env": "NV_O2OA_CURRENT_USER_IDENTITY",
          "marker": "__NV_RUNTIME_CURRENT_USER_IDENTITY__"
        }
      ],
      "hotpicture_zero_check": {
        "read_only_endpoint": "hotpic_list",
        "application": "CMS",
        "before_create_expected_count": 0,
        "after_create_expected_matching_count": 0,
        "after_create_context": "documentId"
      }
    },
    {
      "name": "cms_document_get",
      "method": "GET",
      "path": "/x_cms_assemble_control/jaxrs/document/{documentId}",
      "request_body": "none",
      "runtime_path_parameter": {
        "placeholder": "{documentId}",
        "context": "documentId"
      }
    },
    {
      "name": "cms_document_data_update",
      "method": "PUT",
      "path": "/x_cms_assemble_control/jaxrs/data/document/{documentId}",
      "mutation_profile": "o2oa_document_data_update",
      "runtime_path_parameter": {
        "placeholder": "{documentId}",
        "context": "documentId"
      }
    },
    {
      "name": "cms_document_data_get",
      "method": "GET",
      "path": "/x_cms_assemble_control/jaxrs/data/document/{documentId}",
      "request_body": "none",
      "runtime_path_parameter": {
        "placeholder": "{documentId}",
        "context": "documentId"
      }
    },
    {
      "name": "hotpic_list",
      "method": "PUT",
      "path": "/x_hotpic_assemble_control/jaxrs/user/hotpic/filter/list/page/1/count/6"
    },
    {
      "name": "cms_doc_list",
      "method": "PUT",
      "path": "/x_cms_assemble_control/jaxrs/document/filter/list/1/size/5"
    },
    {
      "name": "calendar_filter",
      "method": "PUT",
      "path": "/x_calendar_assemble_control/jaxrs/event/list/filter"
    }
  ],

  "biz_fields": ["type", "message", "msg", "code"],

  "body_templates": {
    "person_detail": {},
    "review_count": {
      "credentialList": []
    },
    "hotpic_list": {
      "application": "CMS"
    },
    "cms_doc_list": {
      "docStatusList": [],
      "categoryIdList": [],
      "key": ""
    },
    "calendar_filter": {
      "startTime": "2026-03-01 00:00:00",
      "endTime": "2026-03-31 23:59:59",
      "calendarIds": []
    }
  }
}
