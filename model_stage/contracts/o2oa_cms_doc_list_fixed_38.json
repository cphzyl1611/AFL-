  "feature_semantics": {
    "body_bytes": "UTF-8 byte length of canonical JSON input",
    "json_depth": "recursive depth with scalar root at one and empty containers adding one",
    "total_keys": "sum of keys in all objects",
    "total_nodes": "all recursively visited nodes including root",
    "dict_count": "object node count",
    "list_count": "array node count",
    "string_count": "string value count",
    "number_count": "integer and floating-point value count",
    "bool_count": "Boolean value count",
    "null_count": "null value count",
    "max_string_len": "maximum Unicode code-point string length",
    "avg_string_len": "average Unicode code-point string length",
    "max_list_len": "maximum array length",
    "avg_list_len": "average array length",
    "max_run_length_any_string": "maximum equal-character run",
    "avg_run_length_strings": "average per-string maximum equal-character run",
    "max_special_ratio": "maximum ratio using SPECIAL_CHARS",
    "avg_special_ratio": "average ratio using SPECIAL_CHARS",
    "max_space_ratio": "maximum Python str.isspace ratio",
    "avg_space_ratio": "average Python str.isspace ratio",
    "max_case_flip_ratio": "maximum alphabetic lower-case transition ratio",
    "avg_case_flip_ratio": "average alphabetic lower-case transition ratio",
    "min_unique_char_ratio": "minimum unique-character ratio",
    "avg_unique_char_ratio": "average unique-character ratio",
    "max_list_repeat_ratio": "maximum encoded list repetition ratio",
    "avg_list_repeat_ratio": "average encoded list repetition ratio",
    "repeated_list_count": "arrays with repetition ratio at least 0.7",
    "large_list_count": "arrays with length at least 10",
    "long_item_list_count": "arrays containing a string longer than 32 code points",
    "has_key_field": "root key is a string",
    "key_len": "root key Unicode code-point length",
    "key_run_length": "root key maximum equal-character run",
    "key_special_ratio": "root key SPECIAL_CHARS ratio",
    "key_unique_char_ratio": "root key unique-character ratio",
    "docStatusList_len": "root docStatusList array length",
    "docStatusList_repeat_ratio": "root docStatusList encoded repetition ratio",
    "categoryIdList_len": "root categoryIdList array length",
    "categoryIdList_repeat_ratio": "root categoryIdList encoded repetition ratio"
  },
  "utf8_policy": {
    "mode": "strict",
    "invalid_input": "reject"
  },
  "json_parse_policy": {
    "parser": "Python json.loads with duplicate-key and parse-constant hooks",
    "root_type": "object",
    "duplicate_keys": "reject",
    "nonfinite_constants": "reject"
  },
  "json_canonicalization_policy": {
    "policy_id": "python-json-sorted-compact-utf8-v1",
    "sort_keys": true,
    "ensure_ascii": false,
    "separators": [
      ",",
      ":"
    ],
    "allow_nan": false,
    "output_encoding": "UTF-8"
  },
  "body_bytes_policy": {
    "source": "canonical_json_bytes",
    "value": "len(canonical_json_bytes)",
    "raw_identity_field": "raw_body_sha256",
    "canonical_identity_field": "canonical_json_sha256"
  },
  "string_length_policy": "Python Unicode code-point length via len(str)",
  "list_repetition_policy": {
    "scalar_encoding": "s:<value>, b:<value>, n:<value>, null, or t:<type>",
    "container_encoding": "dict or list type name",
    "threshold": 0.7
  },
  "special_character_policy": {
    "characters": "!@#$%^&*?~|\\/`'\";:<>,+="
  },
  "whitespace_policy": "Python str.isspace()",
  "case_flip_policy": "filter isalpha characters and compare adjacent islower states",
  "unique_character_policy": "len(set(s))/len(s), with empty string equal to 1.0",
  "empty_value_policy": {
    "empty_body": "reject",
    "empty_string": "count string; zero length/run/ratios except unique ratio 1.0",
    "empty_list": "count list; length and repetition ratio zero",
    "empty_object": "count object; zero keys"
  },
  "missing_value_policy": {
    "missing_scalar_feature": 0.0,
    "missing_string_collection": 0.0,
    "missing_unique_string_collection": 1.0,
    "missing_endpoint_field": 0.0
  },
  "nonfinite_policy": {
    "json_constants": "reject NaN, Infinity, and -Infinity",
    "feature_vector": "reject any non-finite value"
  },
