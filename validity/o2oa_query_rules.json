{
  "common": {
    "max_bytes": 16384,
    "max_depth": 8,
    "max_keys": 128,
    "max_string": 2048
  },
  "endpoints": {
    "cms_doc_list": {
      "type": "object",
      "required": ["docStatusList", "categoryIdList", "key"],
      "allow_unknown": true,
      "properties": {
        "docStatusList": {
          "type": "array",
          "maxItems": 20
        },
        "categoryIdList": {
          "type": "array",
          "maxItems": 20
        },
        "key": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "review_count": {
      "type": "object",
      "required": ["credentialList"],
      "allow_unknown": true,
      "properties": {
        "credentialList": {
          "type": "array",
          "maxItems": 20
        }
      }
    },
    "cms_attachment_download_query": {
      "transport": "url_query",
      "request_body": "none",
      "query": {
        "type": "object",
        "required": [],
        "allow_unknown": false,
        "properties": {
          "fileName": {
            "types": ["string", "array"],
            "maxLength": 2048,
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      }
    },
    "file_share_list_my_query": {
      "transport": "url_query",
      "request_body": "none",
      "query": {
        "type": "object",
        "required": ["fileType"],
        "allow_unknown": false,
        "properties": {
          "fileType": {
            "type": "string",
            "enum": ["attachment", "folder"]
          }
        }
      }
    },
    "cms_document_create_save": {
      "type": "object",
      "required": ["categoryId", "title", "docStatus", "docData", "readerList"],
      "forbidden": [
        "id",
        "identity",
        "authorList",
        "pictureList",
        "cloudPictures",
        "wf_jobId",
        "wf_workId",
        "wf_attachmentIds",
        "documentNotify",
        "publishTime",
        "dataPaths",
        "skipPermission"
      ],
      "allow_unknown": false,
      "properties": {
        "categoryId": {
          "type": "string",
          "nonBlank": true,
          "minLength": 1,
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "nonBlank": true,
          "minLength": 1,
          "maxLength": 2048
        },
        "docStatus": {
          "type": "string",
          "enum": ["draft"]
        },
        "docData": {
          "type": "object"
        },
        "readerList": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["permissionObjectType", "permissionObjectCode"],
            "allow_unknown": false,
            "properties": {
              "permissionObjectType": {
                "type": "string",
                "enum": ["人员"]
              },
              "permissionObjectCode": {
                "type": "string",
                "nonBlank": true,
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      }
    },
    "cms_document_get": {
      "type": "object",
      "required": [],
      "allow_unknown": false,
      "properties": {}
    },
    "cms_document_data_update": {
      "type": "object",
      "minProperties": 1,
      "required": [],
      "allow_unknown": true,
      "properties": {}
    },
    "cms_document_data_get": {
      "type": "object",
      "required": [],
      "allow_unknown": false,
      "properties": {}
    },
    "hotpic_list": {
      "type": "object",
      "required": [],
      "allow_unknown": true,
      "properties": {}
    },
    "person_detail": {
      "type": "object",
      "required": [],
      "allow_unknown": true,
      "properties": {}
    },
    "calendar_filter": {
      "type": "object",
      "required": ["startTime", "endTime", "calendarIds"],
      "allow_unknown": true,
      "properties": {
        "startTime": {
          "type": "string",
          "maxLength": 64
        },
        "endTime": {
          "type": "string",
          "maxLength": 64
        },
        "calendarIds": {
          "type": "array",
          "maxItems": 50
        }
      }
    }
  }
}
