# Ignore local environments and Python caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.codex

# Ignore fuzzing/runtime outputs
out/
out*/
tmp/
output/
findings/
runner/runs/
runner/tasks/
afl_out/
compare_out/
delivery_pkg/
delivery_pkg_stage_ae/
release_snapshot/
docs/final_results/batch_compare_runs*/
docs/final_results/experiments/
docs/final_delivery/**/*.pt

# Ignore embedded submodule worktrees in the public snapshot
/coresight_mode/coresight-trace/
/custom_mutators/grammar_mutator/grammar_mutator/
/custom_mutators/gramatron/json-c/
/nyx_mode/QEMU-Nyx/
/nyx_mode/libnyx/
/nyx_mode/packer/
/qemu_mode/qemuafl/
/unicorn_mode/unicornafl/

